# ════════════════════════════════════════════════════════════════
# Portal TRK — Git Ignore
# ════════════════════════════════════════════════════════════════

# ─── Ambiente ───
.env
.env.local
.env.production
*.pem
*.key

# ─── Python ───
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/

# ─── Modelos ML ───
backend/models/*.pkl
backend/models/*.joblib

# ─── Relatórios gerados ───
backend/reports/*.pdf

# ─── Uploads ───
backend/data/uploads/

# ─── Certificados ───
backend/data/certs/

# ─── Node / Frontend ───
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# ─── IDE ───
.vscode/
.idea/
*.swp
*.swo
*~

# ─── OS ───
.DS_Store
Thumbs.db
desktop.ini

# ─── Testes ───
.coverage
htmlcov/
.pytest_cache/

# ─── Alembic ───
# Não ignorar versions/ — migrations devem ser versionadas

# ─── Docker ───
*.log

# ─── Protótipo antigo (manter no repo mas não usar) ───
# portal_trk_completo.html é referência visual apenas
